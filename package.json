{
  "name": "total-party-krawl",
  "version": "1.0.0",
  "description": "Total Party Krawl — thin relay + persistence backend (Vercel + Supabase) for the Twitch extension; the Godot client owns all game logic.",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "build": "",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test lib/__tests__/*.test.ts",
    "zip-extension": "cd extension && zip -r ../extension.zip . && cd .."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@vercel/node": "^3.0.26",
    "tsx": "^4.22.4",
    "typescript": "^5.3.2",
    "vercel": "^33.0.0"
  }
}
