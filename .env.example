# ============================================================
# Total Party Krawl — backend env vars (relay + persistence)
# ------------------------------------------------------------
# Copy to .env.local for local `vercel dev`, and set the same keys in the
# Vercel project (Settings -> Environment Variables) for deploys.
# NEVER commit real values. .env / .env.local are gitignored.
# ============================================================

# --- Supabase (service-role; server-side only, bypasses RLS) ---
# Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Project Settings -> API -> service_role secret (NOT the anon key)
SUPABASE_SECRET_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# --- Twitch Extension ---
# Twitch Dev Console -> your Extension -> Settings -> Secret Keys.
# Use the secret EXACTLY as shown (it is base64; the server base64-decodes it
# before HS256-verifying the Extension Helper JWT).
TWITCH_EXTENSION_SECRET=YOUR-TWITCH-EXTENSION-BASE64-SECRET

# --- Twitch client id (optional; defense-in-depth for host pairing) ---
# Twitch Dev Console -> your Extension -> Settings -> Client ID.
# If set, /api/host/session ALSO requires the streamer's Twitch user token to
# have been issued for THIS client_id (verified against id.twitch.tv/validate).
# Leave unset to disable that soft check.
TWITCH_EXTENSION_CLIENT_ID=YOUR-TWITCH-EXTENSION-CLIENT-ID

# --- Host (broadcaster) session signing secret ---
# Signs the short-lived host-session JWT (HS256) the game client presents on
# /api/host/publish and /api/host/moves. Generate a random 256-bit value:
#   openssl rand -hex 32
# Keep it server-side only; rotating it invalidates all live host sessions.
HOST_SESSION_SECRET=YOUR-RANDOM-64-HEX-CHAR-SECRET
