{
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "devCommand": "",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Extension-JWT" }
      ]
    }
  ],
  "rewrites": []
}
